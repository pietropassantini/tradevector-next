[Unit]
Description=TradeVector P2 Signal Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pietro
WorkingDirectory=/home/pietro/tradevector-next
EnvironmentFile=/home/pietro/tradevector-next/.env
ExecStart=/home/pietro/tradevector-next/.venv/bin/python /home/pietro/tradevector-next/scripts/p2_signal_scheduler.py --symbol BTCUSDT
StandardOutput=append:/home/pietro/tradevector-next/logs/p2_scheduler.log
StandardError=append:/home/pietro/tradevector-next/logs/p2_scheduler.log

[Install]
WantedBy=multi-user.target
